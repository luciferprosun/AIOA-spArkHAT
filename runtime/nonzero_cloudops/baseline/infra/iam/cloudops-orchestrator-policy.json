{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadConfiguredSandboxEvidence",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "InvokeExactNovaTwoLiteEuInferenceProfile",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "${NovaTwoLiteEuInferenceProfileArn}",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "InvokeProfileDestinationModelsOnly",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:${AWS::Partition}:bedrock:eu-central-1::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:${AWS::Partition}:bedrock:eu-north-1::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:${AWS::Partition}:bedrock:eu-south-1::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:${AWS::Partition}:bedrock:eu-south-2::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:${AWS::Partition}:bedrock:eu-west-1::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:${AWS::Partition}:bedrock:eu-west-3::foundation-model/amazon.nova-2-lite-v1:0"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "bedrock:InferenceProfileArn": "${NovaTwoLiteEuInferenceProfileArn}"
        }
      }
    },
    {
      "Sid": "DurableItemOnlyState",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "${StateTableArn}"
    },
    {
      "Sid": "InvokePrivateRemediationExecutorAliasOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "${RemediationExecutorAliasArn}"
    },
    {
      "Sid": "ReadDedicatedJudgeSecretOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "${JudgeTokenSecretArn}"
    },
    {
      "Sid": "BoundedXRayDelivery",
      "Effect": "Allow",
      "Action": [
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords"
      ],
      "Resource": "*"
    }
  ]
}

# Nebius Token Factory competition profile (never commit a real key)
NEBIUS_API_KEY=replace-with-your-token-factory-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional Nebius Serverless effect target. Inject the auth token through the
# cloud/operator secret environment; never store a real value in this file.
NEBIUS_SERVERLESS_ENDPOINT_URL=https://your-serverless-host.example/invoke
NEBIUS_SERVERLESS_AUTH_TOKEN=cloud-injected-secret-reference
